# Copy to .env.local. Never commit real secrets.
STORE_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Turso LIBSQL database (remote on Vercel). Local development may use file:./local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Run npm run admin:password, then paste the generated hash here and in Vercel.
ADMIN_PASSWORD_HASH=
# Generate a random secret for keyed, daily-changing abuse-control identifiers.
RATE_LIMIT_SECRET=

# Stripe server secrets. Test first; live checkout also requires launch checks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Optional form forwarding; otherwise submissions are stored in Turso.
CONTACT_FORM_ENDPOINT=
NEWSLETTER_ENDPOINT=
